# RapidAPI Shazam (required for Shazam matching)
RAPIDAPI_KEY=

# Supabase (required for rate limiting)
SUPABASE_URL=
SUPABASE_KEY=

# Rate limits
DAILY_LIMIT=15
MONTHLY_LIMIT=475

# Internal API secret (protects /api/match from direct access)
INTERNAL_API_SECRET=

# AudD (optional)
AUDD_API_TOKEN=

# AcoustID (optional)
ACOUSTID_API_KEY=

# Full path to fpcalc if not on PATH (optional)
FP_CALC_PATH=

# Local spectrogram-peak / constellation-hash index (optional)
FINGERPRINT_INDEX_PATH=

# Shared normalized audio contract
INTERNAL_SAMPLE_RATE=44100
INTERNAL_SAMPLE_WIDTH=2
MIN_AUDIO_SECONDS=1
MAX_AUDIO_SECONDS=30
MAX_UPLOAD_BYTES=10485760
FFMPEG_TIMEOUT_SECONDS=15

# Development convenience; keep disabled outside local debugging
FLASK_DEBUG=0
